<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- firebase_analytics (via play-services-measurement) adds the advertising-ID
         permission by default. This app uses Analytics only for its own product
         metrics — it shows no ads and does no cross-app tracking — so we strip the
         permission. That keeps the Play "Advertising ID" declaration (and the App
         Store privacy label) honestly set to "not used", and stops Play rejecting
         the upload for an undeclared AD_ID permission. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Round alerts. Required from Android 13 (API 33): without it the system
         silently drops every notification, and the members are never told a new
         round has started. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Captains scan members' QR codes to record attendance. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Referral note "add from contacts" reads the picked contact's phone
         number (name;number). iOS uses the permissionless native picker. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus: the app watches for a connection returning to drain
         the offline attendance queue. Without this the check throws and queued
         attendance never syncs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Conclave / 1-2-1 reminders are one-off scheduled notifications. On
         Android 12 SCHEDULE_EXACT_ALARM lets them fire at the minute instead of
         being batched by Doze (which is why a reminder could arrive late or not
         at all). On 13+ it may be revoked — the scheduler falls back to an
         inexact alarm then, so a reminder still fires. We deliberately do NOT
         declare USE_EXACT_ALARM (that is only for alarm-clock/calendar apps and
         Play would flag it here). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Re-arm scheduled reminders after a reboot; without this the OS drops
         every pending alarm on restart and the member gets no reminder. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- The camera is a CAPTAIN's tool. Members only display a QR code, so a
         device without a camera is still perfectly usable. mobile_scanner already
         declares this as optional; repeating it here keeps the intent visible —
         if it ever became required="true", Play would hide the app from those
         devices entirely. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Backup is off deliberately. Android's auto-backup would copy the offline
         SQLite database and cached session to Google Drive and restore it onto a
         DIFFERENT device, resurrecting one member's attendance and referral rows
         under another person's login. The offline DB is a local queue that drains
         to the server; the server is the record. There is nothing here worth
         restoring, and restoring it is actively wrong.

         allowBackup/fullBackupContent cover up to Android 11; dataExtractionRules
         covers cloud backup AND device-to-device transfer on Android 12+. -->
    <application
        android:label="1-2-1 Connect"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Round alerts: status-bar icon and tint.
             The status bar can only draw a single-colour silhouette — it masks by
             alpha and ignores RGB — so ic_stat_conclave is the app icon's mark as
             a white-on-transparent glyph, not the red square (which would show as
             a solid white blob). The colour below is what Android tints it with
             when the notification is expanded. Without this meta-data FCM falls
             back to the full launcher icon and you get the white-square bug. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_conclave" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- flutter_local_notifications: delivers scheduled (zoned) reminders and
             re-arms them after a reboot/app-update, so a conclave or 1-2-1
             reminder survives a restart instead of being silently lost (#1). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
