<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Round alerts. Required from Android 13 (API 33): without it the system
         silently drops every notification, and the members are never told a new
         round has started. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Captains scan members' QR codes to record attendance. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus: the app watches for a connection returning to drain
         the offline attendance queue. Without this the check throws and queued
         attendance never syncs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- The camera is a CAPTAIN's tool. Members only display a QR code, so a
         device without a camera is still perfectly usable. mobile_scanner already
         declares this as optional; repeating it here keeps the intent visible —
         if it ever became required="true", Play would hide the app from those
         devices entirely. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Backup is off deliberately. Android's auto-backup would copy the offline
         SQLite database and cached session to Google Drive and restore it onto a
         DIFFERENT device, resurrecting one member's attendance and referral rows
         under another person's login. The offline DB is a local queue that drains
         to the server; the server is the record. There is nothing here worth
         restoring, and restoring it is actively wrong.

         allowBackup/fullBackupContent cover up to Android 11; dataExtractionRules
         covers cloud backup AND device-to-device transfer on Android 12+. -->
    <application
        android:label="BNI 121 Conclave"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Round alerts: status-bar icon and tint.
             The status bar can only draw a single-colour silhouette — it masks by
             alpha and ignores RGB — so ic_stat_conclave is the app icon's mark as
             a white-on-transparent glyph, not the red square (which would show as
             a solid white blob). The colour below is what Android tints it with
             when the notification is expanded. Without this meta-data FCM falls
             back to the full launcher icon and you get the white-square bug. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_conclave" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
